            <column caption='Host Quality Score' datatype='real' name='[Calculation_1457709457633280]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='0.1*[review_scores_accuracy] + 0.6*[review_scores_communication] + 0.3*[review_scores_checkin]' />
